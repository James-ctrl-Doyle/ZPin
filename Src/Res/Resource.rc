#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS
1 ICON "logo.ico"
icon.ttf RCDATA "iconfont.ttf"
zh-CN RCDATA "../../Lang/简体中文.zh-CN.json"
en-US RCDATA "../../Lang/English.en-US.json"

// 配置可执行文件产品信息
// ⚠ FILEVERSION / PRODUCTVERSION 是 Windows 的定点数格式，**必须是四段**（2,6,0,0），
//    少一段编译器会报错；但下面 StringFileInfo 里那两条是给人看的字符串，
//    写 "2.6.0" 就行 —— 资源管理器、PowerShell 的 VersionInfo 读的是字符串，
//    写成 "2.6.0.0" 界面上就会多出一个尾巴。
//    版本号唯一真源就是这里，改版本要同时改这四处。
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,6,0,0
PRODUCTVERSION 2,6,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "James-ctrl-Doyle"
            VALUE "FileDescription", "ZPin"
            VALUE "FileVersion", "2.6.0"
            VALUE "InternalName", "ZPin.exe"
            VALUE "LegalCopyright", "Copyright (C) LiuXiaoLun 2023-2026, James-ctrl-Doyle 2026"
            VALUE "OriginalFilename", "ZPin.exe"
            VALUE "ProductName", "ZPin"
            VALUE "ProductVersion", "2.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END